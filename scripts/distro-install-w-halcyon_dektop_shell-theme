#!/usr/bin/env bash
set -euo pipefail
shell="${1:-}"
case "$shell" in fish|spire|zsh) ;; *) echo "Usage: distro-install-w-halcyon_dektop_shell-theme <fish|zsh|spire>" >&2; exit 2;; esac
home="${HOME:?HOME is not set}"
backup_once() {
    local file="$1"
    if [[ -f "$file" && ! -e "$file.bak" ]]; then cp -p -- "$file" "$file.bak"; fi
}
case "$shell" in
fish|spire)
 prompt_dir="$home/.config/fish/functions"
 prompt_file="$prompt_dir/fish_prompt.fish"
 mkdir -p "$prompt_dir"
 tmp="$(mktemp)"
 trap 'rm -f "$tmp"' EXIT
 cat > "$tmp" <<'FISH'
# Halcyon prompt (Fish; Spire Shell also loads fish_prompt from ~/.config/fish).
function fish_prompt
 set_color --bold brcyan; printf '╭─ '
 set_color brblue; printf '%s' (prompt_pwd); set_color normal
 if command -q git
  set branch (git branch --show-current 2>/dev/null)
  if test -n "$branch"; set_color brmagenta; printf '   %s' "$branch"; end
 end
 printf '\n╰─ '; set_color --bold brgreen; printf '❯ '; set_color normal
end
FISH
 if [[ -f "$prompt_file" ]] && ! cmp -s "$tmp" "$prompt_file"; then backup_once "$prompt_file"; fi
 if [[ ! -f "$prompt_file" ]] || ! cmp -s "$tmp" "$prompt_file"; then mv -f -- "$tmp" "$prompt_file"; fi
 if [[ "$shell" == spire ]]; then
  cfg="$home/.config/spire/spire.conf"
  mkdir -p "$(dirname "$cfg")"
  [[ -f "$cfg" ]] || touch "$cfg"
  cfg_tmp="$(mktemp)"
  awk '
    !/^[[:space:]]*(fish_config|prompt\.use_fish_prompt)[[:space:]]*=/ &&
    !/^# Halcyon theme: load Fish prompt functions in Spire\.$/ {
        lines[++n] = $0
    }
    END {
        start = 1
        while (start <= n && lines[start] == "") start++
        while (n >= start && lines[n] == "") n--
        for (i = start; i <= n; i++) print lines[i]
    }
  ' "$cfg" > "$cfg_tmp"
  printf '\n# Halcyon theme: load Fish prompt functions in Spire.\nfish_config = yes\nprompt.use_fish_prompt = yes\n' >> "$cfg_tmp"
  if ! cmp -s "$cfg_tmp" "$cfg"; then backup_once "$cfg"; mv -f -- "$cfg_tmp" "$cfg"; else rm -f -- "$cfg_tmp"; fi
  echo "Halcyon prompt installed for Spire Shell. Restart shell."
 else
  echo "Halcyon prompt installed for Fish. Restart shell."
 fi
 ;;
zsh)
 theme_dir="$home/.config/halcyon-shell"
 theme_file="$theme_dir/zsh-theme.zsh"
 mkdir -p "$theme_dir"
 tmp="$(mktemp)"
 trap 'rm -f "$tmp"' EXIT
 cat > "$tmp" <<'ZSH'
# Halcyon Zsh prompt. Uses zsh's hook system without replacing other precmd hooks.
autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:git:*' formats ' %F{magenta} %b%f'
halcyon_precmd() { vcs_info }
add-zsh-hook precmd halcyon_precmd
setopt PROMPT_SUBST
PROMPT='%F{cyan}%B╭─%b %F{blue}%~%f${vcs_info_msg_0_}\n%F{cyan}%B╰─%b %F{green}%B❯%b%f '
ZSH
 if [[ -f "$theme_file" ]] && ! cmp -s "$tmp" "$theme_file"; then backup_once "$theme_file"; fi
 if [[ ! -f "$theme_file" ]] || ! cmp -s "$tmp" "$theme_file"; then mv -f -- "$tmp" "$theme_file"; fi
 zsh_dir="${ZDOTDIR:-$home}"
 mkdir -p "$zsh_dir"
 zshrc="$zsh_dir/.zshrc"
 if [[ ! -f "$zshrc" ]]; then touch "$zshrc"; fi
 if ! grep -Fq 'halcyon-shell/zsh-theme.zsh' "$zshrc"; then
  backup_once "$zshrc"
  printf '\n# Halcyon shell theme\nsource "$HOME/.config/halcyon-shell/zsh-theme.zsh"\n' >> "$zshrc"
 fi
 echo "Halcyon prompt installed for Zsh. Restart shell."
 ;;
esac
