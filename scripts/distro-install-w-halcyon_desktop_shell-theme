#!/usr/bin/env bash
# Halcyon with another Hyprland desktop shell: installs what the shell needs and makes Halcyon run it (the bar, dock,
# launcher, panels and lock screen; Halcyon's Hyprland config, keys, themes and apps stay). Run it as yourself.
#
#   distro-install-w-halcyon_desktop_shell-theme SHELL [--no-install]
#
#   halcyon   the Halcyon shell (illogical-impulse)
#   glass     Halcyon Glass: the Halcyon shell with see-through panels over hyprland-plus's liquid glass blur
#   summit    Summit: a clean top bar and dock with Rofi menus
#   macshell  MacShell: a macOS Tahoe style menu bar and Dock in Liquid Glass
#   noctalia  Noctalia Shell v5 (github.com/noctalia-dev/noctalia, MIT)
#   auto      each Halcyon theme brings its own shell again
#
# --no-install skips pacman (the installer has put the packages in already). Halcyon itself is `halcyon shell SHELL`;
# this is the same, with the packages, for a system set up without them.
set -euo pipefail

me="distro-install-w-halcyon_desktop_shell-theme"
usage() {
    echo "Usage: $me <halcyon|glass|summit|macshell|noctalia|auto> [--no-install]" >&2
    exit 2
}
shell="${1:-}"
install=1
[[ "${2:-}" == "--no-install" ]] && install=0
case "$shell" in halcyon|glass|summit|macshell|noctalia|auto) ;; -h|--help) usage ;; *) usage ;; esac

if [[ "$(id -u)" == 0 && -z "${DISTRO_ALLOW_ROOT:-}" ]]; then
    echo "$me: run it as the user whose desktop it is, not as root (it asks for sudo when it installs)" >&2
    exit 1
fi

home="${HOME:?HOME is not set}"
tool="${XDG_CONFIG_HOME:-$home/.config}/hypr/hyprland/halcyon/halcyon-theme"
if [[ ! -x "$tool" ]]; then
    echo "$me: Halcyon is not set up for ${USER:-you} (no $tool); install the Halcyon desktop first" >&2
    exit 1
fi

# What each shell needs beyond Halcyon itself.
packages=()
case "$shell" in
    glass) packages=("hyprland-plus>=0.57.2.p4") ;;
    summit) packages=(illogical-impulse-summit) ;;
    macshell) packages=(illogical-impulse-macshell) ;;
    noctalia) packages=(noctalia) ;;
esac
if ((install)) && ((${#packages[@]})); then
    missing=()
    for package in "${packages[@]}"; do
        pacman -T "$package" >/dev/null 2>&1 || missing+=("${package%%[<>=]*}")
    done
    if ((${#missing[@]})); then
        echo "Installing ${missing[*]}"
        sudo pacman -S --needed --noconfirm "${missing[@]}"
    fi
fi

exec "$tool" shell "$shell"
