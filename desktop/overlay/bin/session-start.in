#!/usr/bin/env bash
# Runs once per Hyprland login (from ~/.config/hypr/@DISTRO_ID@/init.lua).
#  - first login: the settings end-4's installer applies with gsettings/kwriteconfig
#  - resumes setup tasks that need the network (AI tools, models), if any
#  - opens the welcome wizard until it has been completed
set -u
state="${XDG_STATE_HOME:-$HOME/.local/state}/@DISTRO_ID@"
mkdir -p "$state"

if [[ ! -e "$state/session-initialised" ]]; then
    if command -v gsettings >/dev/null; then
        gsettings set org.gnome.desktop.interface font-name 'Google Sans Flex Medium 11 @opsz=11,wght=500' || true
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true
    fi
    if command -v kwriteconfig6 >/dev/null; then
        kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle Darkly || true
        kwriteconfig6 --file kdeglobals --group General --key TerminalApplication konsole || true
        kwriteconfig6 --file kdeglobals --group General --key TerminalService org.kde.konsole.desktop || true
    fi
    if command -v xdg-user-dirs-update >/dev/null; then
        xdg-user-dirs-update || true
    fi
    touch "$state/session-initialised"
fi

# Live ISO: the installer instead of setup tasks and the welcome wizard.
if [[ -e /etc/@DISTRO_ID@/live ]]; then
    systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE 2>/dev/null || true
    sleep 2
    command -v @DISTRO_ID@-installer >/dev/null && exec @DISTRO_ID@-installer
    exit 0
fi

# An extra desktop (its own home, distro-desktop-session) may have left its HOME and XDG directories on the user's
# services if it did not end cleanly: Halcyon's services use the real ones.
systemctl --user unset-environment XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME 2>/dev/null || true
systemctl --user set-environment HOME="$HOME" 2>/dev/null || true
# Make the session's PATH (with ~/.local/bin) visible to user services.
systemctl --user import-environment PATH HALCYON_FASTFETCH_LOGO_OVERRIDE WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE 2>/dev/null || true

# External desktop profiles: run the upstream setup in a visible terminal once.
profile_state="${XDG_STATE_HOME:-$HOME/.local/state}/distro-desktop-profiles"
# (A selection made in Welcome, or in the installer, that has not finished installing.)
profile_installer="$(command -v distro-install-desktop-profiles || true)"
profile_selection="${XDG_CONFIG_HOME:-$HOME/.config}/@DISTRO_ID@/desktop-profiles.conf"
if [[ -n "$profile_installer" && ! -e "$profile_state/completed" \
      && ( -f "$profile_selection" || -f /etc/distro-desktop-profiles.conf ) ]]; then
    (
        for _ in {1..180}; do
            [[ -e "$state/firstboot-done" ]] && break
            sleep 2
        done
        [[ -e "$state/firstboot-done" ]] || exit 0
        sleep 3
        alacritty -e "$profile_installer"
    ) &
fi
# Halcyon's preview for the login screen's desktop switcher: a small screenshot shortly after login, before apps are
# open (the extra desktops save theirs from distro-desktop-session). Off with ~/.config/@DISTRO_ID@/no-session-preview.
previews=/var/lib/@DISTRO_ID@/session-previews
if [[ -d "$previews" && -w "$previews" && ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/@DISTRO_ID@/no-session-preview" ]] \
        && command -v grim >/dev/null; then
    (
        sleep 10
        grim -s 0.5 -t png "$previews/.hyprland.png.tmp" 2>/dev/null \
            && mv -f "$previews/.hyprland.png.tmp" "$previews/hyprland.png" && chmod 0644 "$previews/hyprland.png"
    ) &
fi
# Setup tasks left over from an offline installation (no-op when none).
@DISTRO_CLI@ setup resume --background >/dev/null 2>&1 &

if [[ ! -e "$state/firstboot-done" ]] && command -v @DISTRO_ID@-welcome >/dev/null; then
    sleep 4
    exec @DISTRO_ID@-welcome --first-boot
fi
