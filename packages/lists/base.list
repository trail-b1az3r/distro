# Base system: installed on every profile.
# One package per line. Kernels, microcode, firmware extras and GPU drivers are
# chosen per machine by the installer (see hardware/gpu/drivers.toml).
base
base-devel
linux-firmware
sof-firmware
alsa-firmware
mkinitcpio
sudo
bash-completion
man-db
man-pages
texinfo
micro
vim
less
which

# Package management: pacman stays the package manager; yay handles the AUR.
pacman-contrib
reflector
endeavouros-keyring
endeavouros-mirrorlist
eos-rankmirrors
yay

# Shells and everyday tools
git
fish
openssh
curl
wget
jq
unzip
zip
7zip
rsync
htop
btop
fastfetch
lsof
usbutils
pciutils
hwdata
smartmontools
nvme-cli

# Python: 3.14 (Arch's python) and 3.15, each with pip (pip3.14 / pip3.15)
python
python-pip
python315
python315-pip

# Markdown Extended Logic: mdxl-cli, mdxl-preview and Kate syntax for .mdxl
mdxl

# Storage, encryption and boot
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
xfsprogs
cryptsetup
lvm2
efibootmgr
zram-generator
plymouth

# Networking and Bluetooth
networkmanager
wpa_supplicant
bluez
bluez-utils

# Audio: PipeWire with WirePlumber
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
gst-plugin-pipewire
alsa-utils

# Power
power-profiles-daemon
upower

# Distribution components
@DISTRO_ID@-core
@DISTRO_ID@-branding
