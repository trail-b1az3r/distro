# Network firmware not included in the default linux-firmware dependency set.
# Include every optional adapter family so the live ISO can bring up uncommon
# Wi-Fi, WWAN, and enterprise NICs without downloading firmware first.
linux-firmware-liquidio
linux-firmware-marvell
linux-firmware-mellanox
linux-firmware-nfp
linux-firmware-qcom
linux-firmware-qlogic

# WWAN connection management; kernel drivers are supplied by linux.
modemmanager
