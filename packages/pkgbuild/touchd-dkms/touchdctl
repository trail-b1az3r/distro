#!/usr/bin/env bash
set -euo pipefail

CONFIG="${TOUCHD_CONFIG:-/etc/iptsd.d/80-touchd-surface-pro-5.conf}"
PROFILE="${TOUCHD_PROFILE:-/usr/share/touchD/iptsd-surface-pro-5.conf}"
CALIBRATION="${TOUCHD_CALIBRATION:-/etc/iptsd.d/90-calibration.conf}"
DMI="${TOUCHD_DMI:-/sys/class/dmi/id}"

usage() {
  cat <<'EOF'
touchdctl — Surface IPTS control utility

  status                 Show IPTS driver, daemon, device, profile and calibration status
  model                  Print the detected Surface model (nothing when unsupported)
  doctor                 Check every piece touch and pen need, and say how to fix what is missing
  profile [MODEL]        Back up and install the IPTSD profile (MODEL: auto, the default, or
                         surface-pro-4, surface-pro-5, surface-pro-6, surface-book, surface-laptop)
  calibrate [--apply]    Run iptsd-calibrate (interactive); with --apply, write its final
                         SizeMin/SizeMax/AspectMin/AspectMax to the calibration drop-in
  restart                Restart the detected iptsd service
  handwriting            Launch an installed Wayland handwriting overlay
  pen-buttons            Print the Hyprland Plus pen-button configuration guide
EOF
}

need_root() {
  if (( EUID != 0 )); then
    echo "Run this command with sudo." >&2
    exit 1
  fi
}

# The Surface model from the firmware tables, as the profile names spell it; empty when unknown.
detect_model() {
  local product=""
  [[ -r "$DMI/product_name" ]] && product="$(<"$DMI/product_name")"
  case "$product" in
    "Surface Pro 4") echo surface-pro-4 ;;
    "Surface Pro") echo surface-pro-5 ;;   # the 2017 Surface Pro reports no number
    "Surface Pro 6") echo surface-pro-6 ;;
    "Surface Book"|"Surface Book 2") echo surface-book ;;
    "Surface Laptop"|"Surface Laptop 2") echo surface-laptop ;;
    *) echo "" ;;
  esac
}

# Every supported model uses the same IPTS digitizer generation; the profile was tuned on a Surface Pro 5.
profile_supported() {
  case "$1" in
    surface-pro-4|surface-pro-5|surface-pro-6|surface-book|surface-laptop) return 0 ;;
    *) return 1 ;;
  esac
}

# The kernel's config: /proc/config.gz (Arch), else /boot/config-* (Debian-style), else the headers' copy.
kernel_config() {
  local kernel="${1:-$(uname -r)}"
  if [[ "$kernel" == "$(uname -r)" && -r /proc/config.gz ]]; then
    zcat /proc/config.gz 2>/dev/null
  elif [[ -r "/boot/config-$kernel" ]]; then
    cat "/boot/config-$kernel"
  elif [[ -r "/usr/lib/modules/$kernel/build/.config" ]]; then
    cat "/usr/lib/modules/$kernel/build/.config"
  fi
}

# loaded, built-in, available (a module that is installed but not loaded yet), or missing.
ipts_state() {
  if grep -qE '^ipts ' /proc/modules 2>/dev/null; then
    echo loaded
  elif kernel_config | grep -q '^CONFIG_HID_IPTS=y'; then
    echo built-in
  elif modinfo -F filename ipts >/dev/null 2>&1; then
    echo available
  else
    echo missing
  fi
}

# Where the IPTS module comes from: kernel (the kernel's own, e.g. linux-surface), dkms (touchD's), or nothing.
ipts_source() {
  local file
  file="$(modinfo -F filename ipts 2>/dev/null || true)"
  case "$file" in
    "") echo "" ;;
    */updates/*|*/extra/*) echo dkms ;;
    *) echo kernel ;;
  esac
}

secure_boot() {
  if command -v mokutil >/dev/null 2>&1; then
    mokutil --sb-state 2>/dev/null | grep -qi 'SecureBoot enabled' && echo on || echo off
  else
    echo unknown
  fi
}

# Older iptsd-calibrate printed the values; newer ones write snippets. The last value printed for a key for a key ("SizeMin: 0.123" or "SizeMin = 0.123").
last_value() {
  grep -oE "$1[[:space:]]*[:=][[:space:]]*[0-9]+(\.[0-9]+)?" "$2" | tail -n1 | grep -oE '[0-9]+(\.[0-9]+)?$' || true
}

write_calibration() {
  local log="$1" dir="$2" key value body="" snippet=""
  # iptsd 2+ writes three snippets into its working directory: 0 mm, 2 mm (recommended) and 10 mm of slack.
  snippet="$(find "$dir" -maxdepth 1 -name 'iptsd_calib_*_2mm.conf' -print -quit 2>/dev/null)"
  [[ -n "$snippet" ]] || snippet="$(find "$dir" -maxdepth 1 -name 'iptsd_calib_*.conf' -print -quit 2>/dev/null)"
  for key in SizeMin SizeMax AspectMin AspectMax; do
    value=""
    [[ -n "$snippet" ]] && value="$(last_value "$key" "$snippet")"
    [[ -n "$value" ]] || value="$(last_value "$key" "$log")"
    if [[ -z "$value" ]]; then
      echo "iptsd-calibrate reported no $key; nothing written. Run it again and touch the screen longer." >&2
      return 1
    fi
    body+="$key = $value"$'\n'
  done
  if [[ "${TOUCHD_NIXOS_MANAGED:-0}" == "1" ]]; then
    echo "NixOS: put these in services.touchD.calibration in your configuration:"
    printf '%s' "$body"
    return 0
  fi
  if [[ -e "$CALIBRATION" ]]; then
    cp -a "$CALIBRATION" "$CALIBRATION.touchD-backup.$(date +%Y%m%d-%H%M%S)"
  fi
  install -d "$(dirname "$CALIBRATION")"
  printf '# Written by touchdctl calibrate --apply on %s.\n[Contacts]\n%s' "$(date -Iseconds)" "$body" > "$CALIBRATION"
  echo "Wrote $CALIBRATION:"
  printf '%s' "$body"
}

problems=0
check() {
  # check LABEL OK-OR-EMPTY FIX
  if [[ "$2" == ok ]]; then
    printf '  ok    %s\n' "$1"
  else
    printf '  FIX   %s\n        %s\n' "$1" "$3"
    problems=$((problems + 1))
  fi
}

cmd="${1:-}"
case "$cmd" in
  status)
    echo "Kernel: $(uname -r)"
    model="$(detect_model)"
    echo "Model: ${model:-unknown ($(cat "$DMI/product_name" 2>/dev/null || echo 'no DMI'))}"
    case "$(ipts_state)" in
      loaded) echo "IPTS module: loaded ($(ipts_source))" ;;
      built-in) echo "IPTS module: built into kernel" ;;
      available) echo "IPTS module: installed ($(ipts_source)), not loaded" ;;
      *) echo "IPTS module: missing" ;;
    esac
    if [[ -e "$CONFIG" ]]; then echo "Profile: $CONFIG"; else echo "Profile: not installed (sudo touchdctl profile)"; fi
    if [[ -e "$CALIBRATION" ]]; then echo "Calibration: $CALIBRATION"; else echo "Calibration: none (sudo touchdctl calibrate --apply)"; fi
    if command -v iptsd-find-hidraw >/dev/null 2>&1; then
      iptsd-find-hidraw || true
    fi
    if command -v iptsd-systemd >/dev/null 2>&1; then
      iptsd-systemd -t touchscreen -i 0 -- --no-pager --full status || true
    else
      echo "iptsd-systemd is missing; update iptsd."
    fi
    ;;
  model)
    # The detected model, as the profile names it; nothing (and failure) when it isn't a supported Surface.
    model="$(detect_model)"
    [[ -n "$model" ]] && echo "$model"
    [[ -n "$model" ]]
    ;;
  doctor)
    echo "touchD doctor"
    state="$(ipts_state)"
    check "IPTS kernel driver ($state)" "$([[ $state != missing ]] && echo ok)" \
      "Boot the linux-surface kernel, or install touchd-dkms with headers for $(uname -r) (then: sudo dkms autoinstall)."
    if [[ $state == available ]]; then
      check "IPTS driver loaded" "" "sudo modprobe ipts (it loads by itself at boot when the touch controller is found)"
    fi
    if [[ "$(ipts_source)" == dkms && "$(secure_boot)" == on ]]; then
      check "touchD's IPTS module can load under Secure Boot" "" \
        "Secure Boot refuses unsigned DKMS modules: sign it with your MOK, use the linux-surface kernel, or turn Secure Boot off."
    fi
    check "iptsd installed" "$(command -v iptsd >/dev/null 2>&1 && echo ok)" "Install iptsd (sudo pacman -S iptsd)."
    hidraw=""
    if command -v iptsd-find-hidraw >/dev/null 2>&1; then hidraw="$(iptsd-find-hidraw 2>/dev/null || true)"; fi
    check "touchscreen found (${hidraw:-none})" "$([[ -n $hidraw ]] && echo ok)" \
      "No IPTS hidraw device: check dmesg for ipts errors, and that the kernel driver is loaded."
    active=""
    if command -v iptsd-systemd >/dev/null 2>&1 && iptsd-systemd -t touchscreen -i 0 -- is-active --quiet 2>/dev/null; then active=ok; fi
    check "iptsd service running" "$active" "sudo touchdctl restart"
    check "touchD profile installed" "$([[ -e $CONFIG ]] && echo ok)" "sudo touchdctl profile"
    if [[ ! -e "$CALIBRATION" ]]; then
      echo "  note  not calibrated yet: sudo touchdctl calibrate --apply tunes finger and palm sizes to your screen"
    fi
    if (( problems == 0 )); then echo "Everything touch and pen need is in place."; else echo "$problems thing(s) to fix."; fi
    (( problems == 0 ))
    ;;
  profile)
    model="${2:-auto}"
    if [[ "$model" == auto ]]; then
      model="$(detect_model)"
      if [[ -z "$model" ]]; then
        echo "This does not look like a supported Surface ($(cat "$DMI/product_name" 2>/dev/null || echo unknown))." >&2
        echo "Name the model to install anyway, for example: touchdctl profile surface-pro-5" >&2
        exit 1
      fi
      echo "Detected $model."
    fi
    profile_supported "$model" || { usage >&2; exit 2; }
    need_root
    if [[ "${TOUCHD_NIXOS_MANAGED:-0}" == "1" ]]; then
      echo "NixOS manages this IPTSD profile declaratively. Enable services.touchD in your NixOS configuration instead." >&2
      exit 1
    fi
    [[ -r "$PROFILE" ]] || { echo "touchD profile missing: $PROFILE" >&2; exit 1; }
    if [[ -e "$CONFIG" ]]; then
      cp -a "$CONFIG" "$CONFIG.touchD-backup.$(date +%Y%m%d-%H%M%S)"
    fi
    install -Dm644 "$PROFILE" "$CONFIG"
    echo "Installed the IPTSD profile for $model at $CONFIG."
    echo "Existing config was backed up if it existed. Restart with: sudo touchdctl restart"
    ;;
  calibrate)
    apply=0
    if [[ "${2:-}" == "--apply" ]]; then apply=1; fi
    need_root
    command -v iptsd-calibrate >/dev/null 2>&1 || { echo "iptsd-calibrate is not installed; update iptsd." >&2; exit 1; }
    command -v iptsd-foreach >/dev/null 2>&1 || { echo "iptsd-foreach is not installed; update iptsd." >&2; exit 1; }
    command -v iptsd-systemd >/dev/null 2>&1 || { echo "iptsd-systemd is not installed; update iptsd." >&2; exit 1; }
    device=$(iptsd-foreach -t touchscreen -i 0 -- echo {})
    [[ -n "$device" ]] || { echo "Could not identify the IPTS touchscreen hidraw device." >&2; exit 1; }
    echo "Stop the IPTS touchscreen service while collecting samples from $device."
    echo "Touch with each finger, lightly and firmly; press Ctrl+C when the numbers settle."
    iptsd-systemd -t touchscreen -i 0 -- stop
    work="$(mktemp -d)"
    log="$work/calibrate.log"
    finish() {
      iptsd-systemd -t touchscreen -i 0 -- start || true
      rm -rf "$work"
    }
    trap finish EXIT
    # Ctrl+C ends iptsd-calibrate, not this command, so its numbers can still be written. It runs in its own
    # folder: newer versions write their config snippets into the working directory.
    trap '' INT
    (trap - INT; cd "$work" && exec iptsd-calibrate "$device") | tee "$log" || true
    trap - INT
    echo
    if (( apply )); then
      write_calibration "$log" "$work" || exit 1
    else
      echo "Use the reported SizeMin, SizeMax, AspectMin and AspectMax values in:"
      echo "  $CALIBRATION"
      echo "or run: sudo touchdctl calibrate --apply"
    fi
    echo "The IPTS service will be restarted when this command exits."
    ;;
  restart)
    need_root
    command -v iptsd-systemd >/dev/null 2>&1 || { echo "Update iptsd to get iptsd-systemd." >&2; exit 1; }
    exec iptsd-systemd -t touchscreen -i 0 -- restart
    ;;
  handwriting)
    if command -v handwrite-input-client >/dev/null 2>&1 && command -v handwrite-input >/dev/null 2>&1; then
      if ! pgrep -u "$(id -u)" -f '[h]andwrite-input' >/dev/null 2>&1; then
        nohup handwrite-input >/dev/null 2>&1 &
        sleep 0.5
      fi
      exec handwrite-input-client show
    elif command -v katip-ink >/dev/null 2>&1; then
      exec katip-ink
    else
      echo "No handwriting overlay is installed."
      echo "Install handwrite-input (recommended for Hyprland) or katip-ink, then run touchdctl handwriting."
      exit 1
    fi
    ;;
  pen-buttons)
    cat <<'EOF'
Hyprland Plus pen controls (add to ~/.config/hypr/custom/general.lua):

hl.config({ input = { tablettool = {
    eraser_button_mode = 1,
    eraser_button_override = 331 -- BTN_STYLUS; use 332 for BTN_STYLUS2
} } })

Use hyprctl devices and wev to identify tool names and button codes.
Other pen buttons remain available to applications.
EOF
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
