# Maintainer: @DISTRO_NAME@ contributors <@DISTRO_BUG_URL@>
#
# FrontArt (apps/frontart): @DISTRO_NAME@'s painting program, in Qt Widgets and C++: brushes that follow a pen's
# pressure and tilt, layers with blend modes, and OpenRaster files (Krita, GIMP and MyPaint open them). Built from
# the same source tarball as the distribution's other packages.
# Generated from packages/pkgbuild/frontart/PKGBUILD.in.

pkgname=@DISTRO_ID@-frontart
pkgver=@PKGVER@
pkgrel=1
pkgdesc="FrontArt: paint and draw with layers and pen pressure"
arch=(x86_64)
url="@DISTRO_HOME_URL@"
license=(GPL-3.0-or-later)
depends=(qt6-base zlib)
optdepends=('qt6-imageformats: WebP and TIFF pictures')
makedepends=(cmake ninja)
source=("@DISTRO_ID@-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
  cmake -S "@DISTRO_ID@-$pkgver/apps/frontart" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DAPP_ID=@DISTRO_ID@-frontart \
    -DAPP_NAME="FrontArt"
  cmake --build build
}

check() {
  # Paints with pressure, fills, undoes and redoes, and saves and reopens OpenRaster (headless).
  QT_QPA_PLATFORM=offscreen HOME="$srcdir/home" timeout 120 ./build/@DISTRO_ID@-frontart --self-test
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
