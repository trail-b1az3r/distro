# Maintainer: @DISTRO_NAME@ contributors <@DISTRO_BUG_URL@>
#
# hyprland-plus, the Hyprland fork Halcyon is made for (mini, superposition and
# Plus Tiles windows, plus:max_fps). It replaces the stock hyprland package, so
# illogical-impulse-hyprland's dependency on hyprland is met by it. The version
# is the one the dots' release notes name (desktop/dots/docs/releases), pinned
# by commit; bump _commit and pkgver with the dots submodule. Dependencies and
# build follow Arch's hyprland package for the same Hyprland release.
# Rebuild this package when Aquamarine changes its SONAME: the compositor must
# be linked against the same libaquamarine ABI that pacman installs.
# Generated from packages/pkgbuild/hyprland-plus/PKGBUILD.in.

pkgname=hyprland-plus
_commit=eccfd07bc8aa3eb7a9f1488b69cf548e1f743f08
_udis86=5336633af70f3917760a6d441ff02d93477b0c86
pkgver=0.57.2.p1
pkgrel=1
pkgdesc="Hyprland with Halcyon windows, renderer effects, app-scoped pen pressure curves and touchD support"
arch=(x86_64)
url="https://github.com/trail-b1az3r/hyprland-plus"
license=(BSD-3-Clause)
depends=(
  "aquamarine>=0.16.0" cairo glib2 glslang hyprcursor hyprgraphics hyprland-guiutils
  hyprlang hyprutils hyprwire lcms2 libcanberra libdrm libei libglvnd
  libinput libx11 libxcb libxcomposite libxcursor libxfixes libxkbcommon
  libxrender lua mesa muparser pango pixman re2
  tomlplusplus util-linux-libs wayland wayland-protocols xcb-proto xcb-util
  xcb-util-errors xcb-util-image xcb-util-keysyms xcb-util-renderutil
  xcb-util-wm xorg-xwayland
)
makedepends=(cmake git glaze hyprland-protocols hyprwayland-scanner xorgproto)
optdepends=('hyprpm: build and install plugins'
            'xdg-desktop-portal-hyprland: xdg-desktop-portal backend for hyprland')
provides=("hyprland=${pkgver%.p*}" wayland-compositor)
conflicts=(hyprland)
# Halcyon marks a hyprland-plus it built into /usr/local with this stand-in package; the real one takes its place.
replaces=(hyprland-plus-local)
# Moves such a /usr/local build aside, so it cannot start instead of this one (hyprland-plus.install).
install=hyprland-plus.install
source=(
  "hyprland-plus::git+https://github.com/trail-b1az3r/hyprland-plus.git#commit=${_commit}"
  "udis86::git+https://github.com/canihavesomecoffee/udis86.git#commit=${_udis86}"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd hyprland-plus
  # udis86 is a submodule and Arch does not package it: point the submodule at
  # the source makepkg fetched, rather than fetching it during the build.
  git submodule init subprojects/udis86
  git config submodule.subprojects/udis86.url "$srcdir/udis86"
  git -c protocol.file.allow=always submodule update subprojects/udis86
}

build() {
  cd hyprland-plus
  cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_SKIP_RPATH=ON \
    -Wno-dev
  cmake --build build
}

package() {
  cd hyprland-plus
  DESTDIR="$pkgdir" cmake --install build
  rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
  # hyprpm is Arch's own package (it depends on hyprland, which this provides).
  find "$pkgdir" -name '*hyprpm*' -delete
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 CREDITS.md "$pkgdir/usr/share/licenses/$pkgname/CREDITS.md"
  install -Dm644 subprojects/udis86/LICENSE "$pkgdir/usr/share/licenses/$pkgname/udis86/LICENSE"

  # Each Hyprland library at least as new as the one this was built against. Unversioned, pacman left an older one
  # in place on a system that took this package without a full upgrade, and Hyprland could not start (a library
  # such as libaquamarine.so.15 or libhyprutils.so.13 not found) until the user downgraded.
  local i name version
  for i in "${!depends[@]}"; do
    name="${depends[$i]%%[<>=]*}"
    case "$name" in
      aquamarine|hyprcursor|hyprgraphics|hyprlang|hyprutils|hyprwire|hyprland-guiutils)
        version="$(pacman -Q "$name" 2>/dev/null | awk '{print $2}')"
        [[ -n "$version" ]] && depends[$i]="$name>=${version%-*}" ;;
    esac
  done
}
