# nmx is opt-in: installing it changes nothing. `sudo systemctl enable --now nmx` switches over; nmxd then imports
# NetworkManager's saved connections, points DNS at systemd-resolved and turns NetworkManager off, once.

post_install() {
  echo "nmx is installed but not in use. To switch from NetworkManager: sudo systemctl enable --now nmx"
  echo "(saved networks come over; back again: sudo nmxcli device unmanage && sudo systemctl enable --now NetworkManager)"
}

post_upgrade() {
  if [ -d /run/systemd/system ] && systemctl is-active --quiet nmx.service; then
    /usr/bin/nmxcli --internal reexec >/dev/null 2>&1 || true
  fi
}

pre_remove() {
  if [ -d /run/systemd/system ] && systemctl is-active --quiet nmx.service; then
    /usr/bin/nmxcli device unmanage >/dev/null 2>&1 || true
    /usr/bin/nmxcli --internal exit >/dev/null 2>&1 || true
    echo "nmx: removed. Turn NetworkManager back on: sudo systemctl enable --now NetworkManager"
  fi
  systemctl disable nmx.service >/dev/null 2>&1 || true
  rm -f /etc/NetworkManager/conf.d/90-nmx.conf
}
