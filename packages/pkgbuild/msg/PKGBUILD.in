# Maintainer: @DISTRO_NAME@ contributors <@DISTRO_BUG_URL@>
#
# @DISTRO_ID@-msg (apps/msg): your iPhone's messages on @DISTRO_NAME@. Texts, pictures, contacts and search, over
# Bluetooth (MAP and PBAP, through BlueZ) or the cable (libimobiledevice backups). The window is QML (Qt 6), the app
# Python, the message store and its search Rust. The iPhone companion app (sending pictures, contacts with photos)
# is built separately and sideloaded: see apps/msg/README.md.
# Generated from packages/pkgbuild/msg/PKGBUILD.in.

pkgname=@DISTRO_ID@-msg
pkgver=@PKGVER@
pkgrel=1
pkgdesc="@DISTRO_NAME@ Messages: an iPhone messages client over Bluetooth or the cable"
arch=(x86_64)
url="@DISTRO_HOME_URL@"
license=(GPL-3.0-or-later)
depends=(python pyside6 qt6-declarative python-cryptography python-dbus-next glibc gcc-libs)
makedepends=(rust cargo)
checkdepends=(python-pytest)
# SQLite is compiled into the Rust store (rusqlite bundled): makepkg's GCC LTO objects cannot be linked by the
# Rust toolchain's lld.
options=(!lto)
optdepends=('bluez: Bluetooth (messages and contacts)'
            'bluez-obex: Bluetooth messages and contacts (obexd; bluez-utils on older systems)'
            'libimobiledevice: the whole history and pictures over the cable'
            'usbmuxd: the cable, and the companion app over it'
            'avahi: finding the companion app on Wi-Fi'
            'qt6-imageformats: HEIC pictures from the iPhone'
            'libnotify: notifications for new messages'
            'tailscale: the iPhone and remote desktops from anywhere'
            '@DISTRO_ID@-rdp-express: share this computer'"'"'s desktop with the remote desktop viewer')
source=("@DISTRO_ID@-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "@DISTRO_ID@-$pkgver/apps/msg/core"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "@DISTRO_ID@-$pkgver/apps/msg/core"
  CARGO_TARGET_DIR=target cargo build --frozen --release
}

check() {
  cd "@DISTRO_ID@-$pkgver/apps/msg"
  (cd core && cargo test --frozen)
  FRONTLINE_MSG_CORE="$PWD/core/target/release/frontline-msg-core" python -m pytest -q tests
}

package() {
  cd "@DISTRO_ID@-$pkgver/apps/msg"
  local site
  site="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
  install -Dm755 core/target/release/frontline-msg-core "$pkgdir/usr/bin/frontline-msg-core"
  install -d "$pkgdir$site/frontline_msg/qml/icons"
  install -m644 frontline_msg/*.py "$pkgdir$site/frontline_msg/"
  install -m644 frontline_msg/qml/*.qml "$pkgdir$site/frontline_msg/qml/"
  install -m644 frontline_msg/qml/icons/*.svg "$pkgdir$site/frontline_msg/qml/icons/"
  python -m compileall -q -d "$site/frontline_msg" "$pkgdir$site/frontline_msg"
  install -Dm755 bin/frontline-msg "$pkgdir/usr/bin/@DISTRO_ID@-msg"
  install -Dm644 data/frontline-msg.desktop "$pkgdir/usr/share/applications/@DISTRO_ID@-msg.desktop"
  sed -i "s/^Exec=frontline-msg/Exec=@DISTRO_ID@-msg/; s/^Icon=frontline-msg/Icon=@DISTRO_ID@-msg/" \
    "$pkgdir/usr/share/applications/@DISTRO_ID@-msg.desktop"
  install -Dm644 data/frontline-msg.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/@DISTRO_ID@-msg.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/@DISTRO_ID@-msg/README.md"
}
