# surface-contrib: a Surface with IPU3 cameras gets them turned on, and any Surface gets surface-touchd, once
# (an administrator's choice is kept).

# Touch gestures and the touch API on any Surface (surface-touchd waits for iptsd's devices). With "start", it
# also starts now (an upgrade on a running system); a fresh install starts it with the next boot.
_touch_on() {
  grep -q '^Surface' "${SURFACE_CONTRIB_DMI:-/sys/class/dmi/id}/product_name" 2>/dev/null || return 0
  surface-contrib touch on --no-start >/dev/null 2>&1 ||
    echo "surface-contrib: could not turn on surface-touchd; try: sudo surface-contrib touch on"
  [[ "${1:-}" == start ]] && systemctl start surface-touchd.service >/dev/null 2>&1
  echo "surface-contrib: touchscreen gestures and API (surface-touchd) are on; bindings: /etc/surface-touchd.conf"
}

post_install() {
  if surface-contrib model 2>/dev/null | grep -qx ipu3 && [[ ! -e /etc/modules-load.d/v4l2loopback-surface.conf ]]; then
    surface-contrib cameras on --no-start ||
      echo "surface-contrib: could not turn on the cameras; try: sudo surface-contrib cameras on"
  fi
  _touch_on
  if surface-contrib model 2>/dev/null | grep -qx pro5; then
    echo "surface-contrib: modern suspend for the Surface Pro 5: sudo surface-contrib suspend --install"
  fi
  if surface-contrib model 2>/dev/null | grep -qxE 'pro5|pro7plus'; then
    echo "surface-contrib: speaker EQ for these speakers, as your user: surface-contrib speaker-eq"
  fi
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  # surface-touchd arrived in 2026.11.20: turn it on once, like a fresh install (later choices are kept).
  if (( $(vercmp "$2" 2026.11.20) < 0 )); then
    _touch_on start
  fi
  # surface-camd now creates its own v4l2loopback devices: drop the old options file it used to need.
  surface-contrib cameras migrate || true
  # Running cameras switch to the new surface-camd now rather than at the next boot.
  systemctl try-restart 'surface-camd@*.service' >/dev/null 2>&1 || true
}

pre_remove() {
  local cam
  for cam in front rear ir; do
    systemctl disable --now "surface-camd@$cam.service" >/dev/null 2>&1 || true
  done
  systemctl disable --now surface-touchd.service >/dev/null 2>&1 || true
}
