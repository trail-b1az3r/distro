// @DISTRO_PRETTY_NAME@ system information (`sysinfo` in Fish, or
// `fastfetch --config /usr/share/@DISTRO_ID@/fastfetch.jsonc`).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/usr/share/@DISTRO_ID@/branding/generated/logo-256.png",
    "width": 20,
    "height": 10,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;@BRAND_ACCENT_R8@;@BRAND_ACCENT_G8@;@BRAND_ACCENT_B8@" }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "wm", "key": "Desktop" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "shell", "key": "Shell" },
    "separator",
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/" },
    { "type": "display", "key": "Display" },
    { "type": "battery", "key": "Battery" },
    "break",
    "colors"
  ]
}
