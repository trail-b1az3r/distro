<?xml version="1.0" encoding="UTF-8"?>
<!-- @DISTRO_NAME@ logo mark: a faceted hexagonal gem with an "N" cut through it
     and three sparks trailing off its top corner. Colours come from
     distro.conf (BRAND_ACCENT, BRAND_ACCENT_2). -->
<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">
  <defs>
    <linearGradient id="gem" x1="30" y1="230" x2="214" y2="46" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="@BRAND_ACCENT@"/>
      <stop offset="1" stop-color="@BRAND_ACCENT_2@"/>
    </linearGradient>
    <linearGradient id="facet" x1="120" y1="42" x2="120" y2="234" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.28"/>
      <stop offset="0.5" stop-color="#FFFFFF" stop-opacity="0"/>
    </linearGradient>
    <mask id="cut" maskUnits="userSpaceOnUse" x="0" y="0" width="256" height="256">
      <rect width="256" height="256" fill="#fff"/>
      <path d="M 86 176 L 86 100 L 154 176 L 154 100" fill="none" stroke="#000" stroke-width="22" stroke-linecap="round" stroke-linejoin="round"/>
    </mask>
  </defs>
  <!-- The gem with its lit top facet; the N is cut out of it (transparent). -->
  <g mask="url(#cut)">
    <path d="M 120 42 L 203 90 L 203 186 L 120 234 L 37 186 L 37 90 Z" fill="url(#gem)" stroke="url(#gem)" stroke-width="24" stroke-linejoin="round"/>
    <path d="M 120 42 L 203 90 L 120 138 L 37 90 Z" fill="url(#facet)"/>
  </g>
  <!-- Three sparks trailing off the top corner. -->
  <circle cx="214" cy="46" r="13" fill="@BRAND_ACCENT_2@"/>
  <circle cx="237" cy="23" r="8" fill="@BRAND_ACCENT_2@" fill-opacity="0.75"/>
  <circle cx="250" cy="9" r="4.5" fill="@BRAND_ACCENT_2@" fill-opacity="0.5"/>
</svg>
