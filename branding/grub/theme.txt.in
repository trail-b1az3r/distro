# @DISTRO_PRETTY_NAME@ boot menu theme: the live ISO's UEFI menu and GRUB on
# installed systems. Drawn from distro.conf by distrokit.build.branding (the
# background, icons and pixmaps); fonts are made with grub-mkfont at build time
# and GRUB falls back to its built-in font if they are missing.
title-text: ""
desktop-image: "background.png"
desktop-image-scale-method: "crop"
desktop-color: "@BRAND_BG@"
terminal-font: "DejaVu Sans Mono Regular 16"
terminal-box: "terminal_box_*.png"
terminal-left: "10%"
terminal-top: "10%"
terminal-width: "80%"
terminal-height: "80%"

+ image {
    top = 7%
    left = 50%-48
    width = 96
    height = 96
    file = "logo.png"
}

+ label {
    top = 7%+118
    left = 0
    width = 100%
    align = "center"
    text = "@DISTRO_PRETTY_NAME@"
    color = "@BRAND_FG@"
    font = "DejaVu Sans Bold 30"
}

+ label {
    top = 7%+158
    left = 0
    width = 100%
    align = "center"
    text = "@DISTRO_TAGLINE@"
    color = "@BRAND_MUTED@"
    font = "DejaVu Sans Regular 15"
}

# The entries float on the background (no panel: on a tall screen it would be
# mostly empty). The highlight of the chosen entry reaches select_*.png's
# corner size (8 px) beyond the entry on each side, so entries are spaced
# twice that apart.
+ boot_menu {
    left = 30%
    top = 7%+206
    width = 40%
    height = 80%-206
    item_font = "DejaVu Sans Regular 20"
    item_color = "@BRAND_MUTED@"
    selected_item_font = "DejaVu Sans Bold 20"
    selected_item_color = "@BRAND_FG@"
    selected_item_pixmap_style = "select_*.png"
    icon_width = 32
    icon_height = 32
    item_icon_space = 16
    item_height = 40
    item_padding = 6
    item_spacing = 18
    scrollbar = true
    scrollbar_width = 4
    scrollbar_thumb = "thumb_*.png"
}

+ label {
    id = "__timeout__"
    top = 89%
    left = 0
    width = 100%
    align = "center"
    color = "@BRAND_ACCENT_2@"
    font = "DejaVu Sans Regular 15"
    text = "Starting the highlighted entry in %d s"
}

+ label {
    top = 93%
    left = 0
    width = 100%
    align = "center"
    color = "@BRAND_MUTED@"
    font = "DejaVu Sans Regular 15"
    text = "↑ ↓  choose     Enter  start     E  edit     C  command line"
}
