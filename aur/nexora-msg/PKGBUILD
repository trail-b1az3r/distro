# Maintainer: trail-b1az3r <https://github.com/trail-b1az3r>
#
# nexora-msg: an iPhone messages client for Linux. Texts, pictures, contacts and search, over Bluetooth (MAP and
# PBAP, through BlueZ) or the cable (libimobiledevice backups). QML (Qt 6) window, Python app, Rust message store.
# The iPhone companion app is sideloaded separately: https://github.com/trail-b1az3r/distro/releases/tag/nexora-msg-ios
#
# Published from https://github.com/trail-b1az3r/distro (aur/nexora-msg); edit it there.

pkgname=nexora-msg
pkgver=1.0.0
_commit=88f7f1c718debb4c84bb0fdbd960a47f9e55eca6
pkgrel=1
pkgdesc="iPhone messages client: texts, pictures, contacts and search over Bluetooth or the cable"
arch=(x86_64 aarch64)
url="https://github.com/trail-b1az3r/distro/tree/main/apps/msg"
license=(GPL-3.0-or-later)
depends=(python pyside6 qt6-declarative python-cryptography python-dbus-next glibc gcc-libs)
makedepends=(rust cargo)
checkdepends=(python-pytest)
# SQLite is compiled into the Rust store (rusqlite bundled): makepkg's GCC LTO objects cannot be linked by the
# Rust toolchain's lld.
options=(!lto)
optdepends=('bluez: Bluetooth (messages and contacts)'
            'bluez-obex: Bluetooth messages and contacts (obexd)'
            'libimobiledevice: the whole history and pictures over the cable'
            'usbmuxd: the cable, and the companion app over it'
            'avahi: finding the companion app on Wi-Fi'
            'qt6-imageformats: HEIC pictures from the iPhone'
            'libnotify: notifications for new messages')
source=("distro-$_commit.tar.gz::https://github.com/trail-b1az3r/distro/archive/$_commit.tar.gz")
sha256sums=('4edeb533e0424c2799a61a572798a80c398e47382b4519308ee2a610eb78f3f3')

_app() { cd "$srcdir/distro-$_commit/apps/msg"; }

prepare() {
  _app
  cd core
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  _app
  cd core
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  _app
  (cd core && RUSTUP_TOOLCHAIN=stable cargo test --frozen)
  NEXORA_MSG_CORE="$PWD/core/target/release/nexora-msg-core" python -m pytest -q -p no:cacheprovider tests
}

package() {
  _app
  local site
  site="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
  install -Dm755 core/target/release/nexora-msg-core "$pkgdir/usr/bin/nexora-msg-core"
  install -d "$pkgdir$site/nexora_msg/qml/icons"
  install -m644 nexora_msg/*.py "$pkgdir$site/nexora_msg/"
  install -m644 nexora_msg/qml/*.qml "$pkgdir$site/nexora_msg/qml/"
  install -m644 nexora_msg/qml/icons/*.svg "$pkgdir$site/nexora_msg/qml/icons/"
  python -m compileall -q -d "$site/nexora_msg" "$pkgdir$site/nexora_msg"
  install -Dm755 bin/nexora-msg "$pkgdir/usr/bin/nexora-msg"
  install -Dm644 data/nexora-msg.desktop "$pkgdir/usr/share/applications/nexora-msg.desktop"
  install -Dm644 data/nexora-msg.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/nexora-msg.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/nexora-msg/README.md"
}
