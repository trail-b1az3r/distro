# Maintainer: trail-b1az3r <https://github.com/trail-b1az3r>
#
# rdp-express: a remote desktop server for Wayland (Hyprland, sway, wlroots), for frontline-msg's remote desktop
# viewer. Its own encrypted protocol (X25519, ChaCha20-Poly1305, one-time pairing codes); only changed tiles sent,
# as JPEG; listens on localhost and Tailscale by default.
#
# Published from https://github.com/trail-b1az3r/distro (aur/frontline-rdp-express); edit it there.

pkgname=frontline-rdp-express
pkgver=1.0.0
_commit=d54d5845258006e9a3c73613acd352a1862b9e24
pkgrel=1
pkgdesc="Remote desktop server for Wayland (Hyprland, sway, wlroots), for frontline-msg's viewer"
arch=(x86_64 aarch64)
url="https://github.com/trail-b1az3r/distro/tree/main/apps/rdp-express"
license=(GPL-3.0-or-later)
depends=(glibc gcc-libs)
makedepends=(rust cargo)
optdepends=('tailscale: reachable from your tailnet (it listens there by default)'
            'libxkbcommon: the keyboard layout when no keyboard is attached (xkbcli)')
provides=(rdp-express)
# The name before the distribution became Frontline Linux.
replaces=(nexora-rdp-express)
conflicts=(nexora-rdp-express)
source=("distro-$_commit.tar.gz::https://github.com/trail-b1az3r/distro/archive/$_commit.tar.gz")
sha256sums=('d3c23d9983272bfebe5020ab0d2e6d0d77602f0b37e9510fe07ddedc1198c37a')

_app() { cd "$srcdir/distro-$_commit/apps/rdp-express"; }

prepare() {
  _app
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  _app
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  _app
  RUSTUP_TOOLCHAIN=stable cargo test --frozen
}

package() {
  _app
  install -Dm755 target/release/rdp-express "$pkgdir/usr/bin/rdp-express"
  install -Dm644 data/rdp-express.service "$pkgdir/usr/lib/systemd/user/rdp-express.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/rdp-express/README.md"
}
