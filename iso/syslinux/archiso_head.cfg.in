SERIAL 0 115200
UI vesamenu.c32
MENU TITLE @DISTRO_PRETTY_NAME@
MENU BACKGROUND splash.png

MENU WIDTH 72
MENU MARGIN 6
MENU ROWS 8
MENU VSHIFT 14
MENU TABMSGROW 24
MENU CMDLINEROW 24
MENU HELPMSGROW 26
MENU HELPMSGENDROW 29

# Colours from distro.conf. https://wiki.syslinux.org/wiki/index.php/Comboot/menu.c32
MENU COLOR border       30;44   #00000000 #00000000 none
MENU COLOR title        1;36;44 #ff@BRAND_FG_HEX@ #00000000 none
MENU COLOR sel          7;37;40 #ffffffff #d0@BRAND_ACCENT_HEX@ all
MENU COLOR unsel        37;44   #c0@BRAND_FG_HEX@ #00000000 none
MENU COLOR help         37;40   #c0@BRAND_MUTED_HEX@ #00000000 none
MENU COLOR timeout_msg  37;40   #90@BRAND_MUTED_HEX@ #00000000 none
MENU COLOR timeout      1;37;40 #ff@BRAND_ACCENT_2_HEX@ #00000000 none
MENU COLOR msg07        37;40   #90@BRAND_FG_HEX@ #00000000 none
MENU COLOR tabmsg       31;40   #80@BRAND_MUTED_HEX@ #00000000 none

MENU CLEAR
MENU IMMEDIATE
