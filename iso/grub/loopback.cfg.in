# @DISTRO_PRETTY_NAME@ live ISO started as a file by another GRUB (Super GRUB2
# Disk, Ventoy's GRUB mode, a "loopback" menu entry): https://www.supergrubdisk.org/wiki/Loopback.cfg
# ${iso_path} is the ISO file; the live system finds it the same way.
search --no-floppy --set=archiso_img_dev --file "${iso_path}"
probe --set archiso_img_dev_uuid --fs-uuid "${archiso_img_dev}"

set archiso_params="archisobasedir=%INSTALL_DIR% img_dev=UUID=${archiso_img_dev_uuid} img_loop=${iso_path}"
source /boot/grub/menu.cfg
