# Example ISO build configuration: ./build.sh --config iso/build.env.example
# Command-line options override these values. Copy this file and adjust it.

# Installation profile the ISO preselects and carries offline:
# minimal | standard | developer | ai
ISO_PROFILE=standard

# minimal: the distribution's own packages on the ISO, the rest is downloaded
#          while installing (smaller ISO)
# full:    every package an installation can need (installs with no network)
ISO_OFFLINE=minimal

# Reproducible builds: pin Arch packages to one day of the Arch Linux Archive
# (YYYY/MM/DD) and the timestamps to a fixed time (defaults to the commit time).
#ARCHIVE_DATE=2026/09/01
#SOURCE_DATE_EPOCH=1790380800

# Sign packages, the repository database and the checksums with this GPG key
# (see docs/release-process.md). Leave unset for unsigned development builds.
#GPGKEY=0123456789ABCDEF0123456789ABCDEF01234567

# Unprivileged user makepkg runs as on an Arch host (the container build uses
# its own "builder" user).
#BUILD_USER=builder
