#!/usr/bin/env bash
# Live ISO: creates the live user and deploys its desktop with the same code
# an installed system uses (`@DISTRO_CLI@ reset-desktop`). Runs at every boot,
# before the login manager.
set -euo pipefail
user="@LIVE_USER@"

if ! id "$user" &>/dev/null; then
    groupadd -f i2c
    useradd -m -u 1000 -U -G wheel,video,audio,input,i2c -s /usr/bin/fish -c "@DISTRO_NAME@ live user" "$user"
    passwd -d "$user" >/dev/null
fi

# Nano has its own LXQt and MATE sessions. Do not deploy the standard
# Halcyon configuration (or require the Halcyon packages) in that edition.
if [[ ! -e "/etc/@DISTRO_ID@/nano" && ! -e "/home/$user/.config/hypr/@DISTRO_ID@/init.lua" ]]; then
    log="/var/log/@DISTRO_ID@/live-desktop.log"
    mkdir -p "${log%/*}"
    if ! runuser -u "$user" -- env HOME="/home/$user" @DISTRO_CLI@ reset-desktop --yes >"$log" 2>&1; then
        echo "The live desktop could not be set up; see $log" >&2
    fi
fi

# Nano's SDDM session directories contain exactly the two supported
# desktops. Openbox is LXQt's window manager, not an extra offered session.
if [[ -e "/etc/@DISTRO_ID@/nano" ]]; then
    session_dir="/etc/@DISTRO_ID@/xsessions"
    install -d -m 0755 "$session_dir" "/etc/@DISTRO_ID@/wayland-sessions"
    for session in lxqt mate; do
        source="/usr/share/xsessions/$session.desktop"
        if [[ ! -f "$source" ]]; then
            echo "Nano desktop session is missing: $source" >&2
            exit 1
        fi
        ln -sfn "$source" "$session_dir/$session.desktop"
    done
fi

# Keep the installer's log readable for bug reports.
install -d -m 0755 /var/log/@DISTRO_ID@
