#!/usr/bin/env bash
# Live ISO graphical session, started by greetd.
#
# Normally the full desktop (Hyprland), which opens the installer. When
# Hyprland fails (an unsupported GPU), or with the "safe graphics" boot
# entry, the installer runs on its own in cage with software rendering, which
# works on any display the firmware can drive. If that fails too, greetd falls
# back to a text login; this log then says why (the runtime directory, with
# Hyprland's own log, is gone by then).
export XDG_SESSION_TYPE=wayland
log=/tmp/@DISTRO_ID@-live-session.log
exec >>"$log" 2>&1
echo "== $(date '+%F %T') live session; kernel parameters: $(cat /proc/cmdline)"

safe_graphics() { grep -qw '@DISTRO_ID@.safe_graphics=1' /proc/cmdline; }

if ! safe_graphics; then
    compositor=""
    if command -v start-hyprland >/dev/null; then
        compositor=start-hyprland
    elif command -v Hyprland >/dev/null; then
        compositor=Hyprland
    fi
    if [[ -n "$compositor" ]]; then
        echo "-- starting $compositor"
        started=$(date +%s)
        "$compositor" && exit 0 # logged out
        rc=$?
        for f in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/hypr/*/hyprland.log; do
            [[ -f "$f" ]] && { echo "-- end of $f"; tail -n 150 "$f"; }
        done
        echo "-- $compositor exited with status $rc after $(($(date +%s) - started))s"
        # Whether it never came up or crashed later (a GPU driver giving up),
        # the installer on its own beats a text login.
        echo "-- the desktop failed: the installer runs on its own instead"
    fi
fi

echo "-- starting the installer in cage (software rendering)"
export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 QT_QPA_PLATFORM=wayland XDG_CURRENT_DESKTOP=cage
cage -s -d -- /usr/bin/@DISTRO_ID@-installer
rc=$?
echo "-- cage exited with status $rc"
exit $rc
