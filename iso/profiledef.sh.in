#!/usr/bin/env bash
# shellcheck disable=SC2034
#
# archiso profile of the @DISTRO_PRETTY_NAME@ live ISO, generated by
# `python3 -m distrokit.build.iso` from iso/profiledef.sh.in (see
# docs/iso-building.md). The rest of the profile is archiso's releng profile
# with the files under iso/ laid over it.

iso_name="@DISTRO_NAME@"
iso_label="@ISO_LABEL@"
iso_publisher="@ISO_PUBLISHER@"
iso_application="@ISO_APPLICATION@"
iso_version="@ISO_VERSION@"
install_dir="arch"
buildmodes=('iso')
bootmodes=('bios.syslinux' 'uefi.systemd-boot')
arch="x86_64"
pacman_conf="pacman.conf"
airootfs_image_type="squashfs"
airootfs_image_tool_options=(@SQUASHFS_OPTIONS@)
bootstrap_tarball_compression=('zstd' '-c' '-T0' '--long' '-19')
file_permissions=(
  ["/etc/shadow"]="0:0:400"
  ["/root"]="0:0:750"
  ["/root/.gnupg"]="0:0:700"
  ["/etc/sudoers.d"]="0:0:750"
  ["/etc/sudoers.d/10-@DISTRO_ID@-live"]="0:0:440"
  ["/usr/lib/@DISTRO_ID@/bin/@DISTRO_ID@-live-session"]="0:0:755"
  ["/usr/lib/@DISTRO_ID@/bin/@DISTRO_ID@-live-setup"]="0:0:755"
  ["/usr/local/bin/choose-mirror"]="0:0:755"
)
